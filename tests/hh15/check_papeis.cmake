# HH15.2 (docs/planos/HH15-PLANO.md; modelo: n8_produto_papeis do BS): catraca dos papeis do runtime no produto.
# Le o manifesto (runtime_papeis.tsv: papel, fonte; gerado das listas dos alvos em runtime/CMakeLists.txt), o inventario
# independente das fontes (runtime/**/*.cpp) e o mapa do linker do HeadHunter.exe, e falha se:
#   1. uma fonte de runtime/ nao esta no manifesto (fora das que nao sao do hh_runtime: o nucleo hh_runtime_cpu, o stub
#      do HH04 e o stub de validacao, compilado no proprio produto), ou o manifesto tem fonte duplicada ou inexistente,
#      ou dois objetos com o mesmo nome;
#   2. um objeto dos papeis do produto (aot, nativo, simulacao, estavel, diagnostico) falta no mapa, fora da lista
#      fechada de objetos sem chamador no executavel (o linker nao os puxa da biblioteca estatica);
#   3. um objeto dos papeis validacao, hle (HH15.3: BIOS HLE, flash e drive simulados), perifericos (HH15.4: modelo do
#      Maple), aica (HH15.6: modelo da AICA), sb (HH15.7d: modelos do system block e do DMAC) ou intc (HH15.7d2: o
#      controlador de interrupcoes anterior) ou grafico (HH15.7d4c: os modelos graficos) esta no mapa, ou falta um dos
#      objetos do proprio produto no lugar deles (validacao_stubs, hle_ausente, maple_ausente, aica_ausente, sb_ausente,
#      dmac_ausente, event_bus, pvr_ausente);
#   3b. HH15.7d4c: a captura da IR (transitional/render_capture, de qualquer biblioteca) esta no mapa, ou falta o lugar
#      dela (render_capture_ausente) ou o renderizador do produto (hh_transitional:render_devices);
#   4. o mapa tem um objeto do hh_runtime que nao esta no manifesto;
#   5. o carimbo de link do mapa (Timestamp is) nao e o do cabecalho PE do executavel (mapa de outro link).
# A comparacao e por campo do mapa (objeto precedido de espaco), nao por trecho de texto.
# Uso: cmake -DMAP=<map> -DMANIFEST=<tsv> -DSRC=<runtime/> [-DEXE=<exe>] [-DMUTAR=<negativo>] -P check_papeis.cmake
# MUTAR (negativos; cada um tem de reprovar com a mensagem do caso): sem_objeto, com_sonda, com_hle, com_maple, com_aica,
# aica_solto e aica_outra_biblioteca (o modelo sem biblioteca ou de outra), objeto_extra, sem_stub, sem_stub_aica,
# com_sb, sem_stub_sb, com_intc, sem_event_bus, com_grafico, sem_stub_pvr, com_captura, sem_stub_captura,
# sem_render_devices, outra_biblioteca, fonte_fora (uma fonte do runtime some do manifesto), mapa_velho.
foreach(v MAP MANIFEST SRC)
  if(NOT EXISTS "${${v}}")
    message(FATAL_ERROR "${v} ausente: ${${v}}")
  endif()
endforeach()
file(READ "${MAP}" map)
file(STRINGS "${MANIFEST}" rows)
set(fora_do_produto validacao hle perifericos aica sb intc grafico)  # papeis so da verificacao e das ferramentas
set(no_caller snapshot)                                   # diagnostico sem chamador no produto (como no BS)
set(not_runtime cpu/sh4_context.cpp cpu/sh4_runtime.cpp mods/mod_api.cpp cpu/sh4_hw_m3.cpp debug/validacao_stubs.cpp
                system/hle_ausente.cpp system/maple_ausente.cpp system/aica_ausente.cpp system/sb_ausente.cpp
                system/dmac_ausente.cpp system/event_bus.cpp system/pvr_ausente.cpp)
if(MUTAR STREQUAL "sem_objeto")
  string(REPLACE " hh_runtime:sys_logical.obj" " hh_runtime:removido.obj" map "${map}")
elseif(MUTAR STREQUAL "com_sonda")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   hh_runtime:hw_probe.obj\n")
elseif(MUTAR STREQUAL "com_hle")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   hh_runtime:gdrom.obj\n")
elseif(MUTAR STREQUAL "com_maple")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   hh_runtime:maple.obj\n")
elseif(MUTAR STREQUAL "com_aica")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   hh_runtime:aica_regs.obj\n")
elseif(MUTAR STREQUAL "aica_solto")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   aica_regs.obj\n")
elseif(MUTAR STREQUAL "aica_outra_biblioteca")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   hh_modelo:aica_regs.obj\n")
elseif(MUTAR STREQUAL "com_sb")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   hh_runtime:sh4_dmac.obj\n")
elseif(MUTAR STREQUAL "sem_stub_sb")
  string(REPLACE "   sb_ausente.obj" "   hh_runtime:sb_ausente.obj" map "${map}")
elseif(MUTAR STREQUAL "com_intc")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   hh_runtime:holly_intc.obj\n")
elseif(MUTAR STREQUAL "sem_event_bus")
  string(REPLACE "   event_bus.obj" "   hh_runtime:event_bus.obj" map "${map}")
elseif(MUTAR STREQUAL "com_grafico")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   hh_runtime:vram.obj\n")
elseif(MUTAR STREQUAL "sem_stub_pvr")
  # tambem as linhas das inline ("f i <obj>", um espaco so)
  string(REGEX REPLACE "([ \t])pvr_ausente\\.obj" "\\1hh_runtime:pvr_ausente.obj" map "${map}")
elseif(MUTAR STREQUAL "com_captura")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   hh_transitional:render_capture.obj\n")
elseif(MUTAR STREQUAL "sem_stub_captura")
  # tambem as linhas das inline ("f i <obj>", um espaco so)
  string(REGEX REPLACE "([ \t])render_capture_ausente\\.obj" "\\1hh_transitional:render_capture_ausente.obj" map "${map}")
elseif(MUTAR STREQUAL "sem_render_devices")
  string(REPLACE " hh_transitional:render_devices.obj" " hh_transitional:removido.obj" map "${map}")
elseif(MUTAR STREQUAL "objeto_extra")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f   hh_runtime:desconhecido.obj\n")
elseif(MUTAR STREQUAL "sem_stub")
  string(REPLACE "   validacao_stubs.obj" "   hh_runtime:validacao_stubs.obj" map "${map}")
elseif(MUTAR STREQUAL "sem_stub_aica")
  string(REPLACE "   aica_ausente.obj" "   hh_runtime:aica_ausente.obj" map "${map}")
elseif(MUTAR STREQUAL "outra_biblioteca")
  string(REPLACE " hh_runtime:sys_logical.obj" " outra_hh_runtime:sys_logical.obj" map "${map}")
elseif(MUTAR STREQUAL "fonte_fora")
  list(FILTER rows EXCLUDE REGEX "pvr/pvr_video\\.cpp$")
endif()
set(bad "")
set(known "")
set(srcs "")
set(n_product 0)
foreach(row IN LISTS rows)
  if(row MATCHES "^papel")
    continue()
  endif()
  string(REPLACE "\t" ";" f "${row}")
  list(GET f 0 role)
  list(GET f 1 src)
  get_filename_component(obj "${src}" NAME_WE)
  if(src IN_LIST srcs)
    list(APPEND bad "fonte duplicada no manifesto: ${src}")
  endif()
  if(obj IN_LIST known)
    list(APPEND bad "dois objetos com o mesmo nome no manifesto: ${obj}")
  endif()
  if(NOT EXISTS "${SRC}/${src}")
    list(APPEND bad "fonte do manifesto inexistente: ${src}")
  endif()
  list(APPEND srcs "${src}")
  list(APPEND known "${obj}")
  string(REGEX MATCH "[ \t]hh_runtime:${obj}\\.obj" hit "${map}")
  if(role IN_LIST fora_do_produto)
    # revisao Codex HH15.6: o objeto proibido e reconhecido sem biblioteca ou de qualquer biblioteca, nao so do hh_runtime
    string(REGEX MATCH "[ \t:]${obj}\\.obj" hit "${map}")
    if(hit)
      list(APPEND bad "objeto do papel ${role} (so verificacao e ferramentas) no produto: ${obj}")
    endif()
  else()
    math(EXPR n_product "${n_product} + 1")
    if(NOT hit AND NOT obj IN_LIST no_caller)
      list(APPEND bad "objeto do papel ${role} ausente do mapa: ${obj}")
    endif()
  endif()
endforeach()
# inventario independente: toda fonte de runtime/ e do manifesto ou da lista fechada do que nao e do hh_runtime
file(GLOB_RECURSE tree RELATIVE "${SRC}" "${SRC}/*.cpp")
foreach(t IN LISTS tree)
  if(NOT t IN_LIST srcs AND NOT t IN_LIST not_runtime)
    list(APPEND bad "fonte do runtime fora do manifesto: ${t}")
  endif()
endforeach()
foreach(s validacao_stubs hle_ausente maple_ausente aica_ausente sb_ausente dmac_ausente event_bus pvr_ausente
          render_capture_ausente)
  string(REGEX MATCH "[ \t]${s}\\.obj" stub "${map}")
  if(NOT stub)
    list(APPEND bad "o stub ${s}.obj (objeto do proprio produto) nao esta no mapa")
  endif()
endforeach()
# HH15.7d4c: a captura da IR (so verificacao) fora, de qualquer biblioteca; o renderizador do produto dentro
string(REGEX MATCH "[ \t:]render_capture\\.obj" cap "${map}")
if(cap)
  list(APPEND bad "captura da IR (so verificacao) no produto: render_capture")
endif()
string(REGEX MATCH "[ \t]hh_transitional:render_devices\\.obj" dev "${map}")
if(NOT dev)
  list(APPEND bad "renderizador do produto ausente do mapa: render_devices")
endif()
string(REGEX MATCHALL "[ \t][A-Za-z0-9_]*hh_runtime:[A-Za-z0-9_]+\\.obj" in_map "${map}")
set(objs "")
foreach(m IN LISTS in_map)
  string(STRIP "${m}" m)
  if(NOT m MATCHES "^hh_runtime:")
    list(APPEND bad "objeto de outra biblioteca com o nome do runtime: ${m}")
    continue()
  endif()
  string(REGEX REPLACE "^hh_runtime:([A-Za-z0-9_]+)\\.obj$" "\\1" o "${m}")
  list(APPEND objs "${o}")
  if(NOT o IN_LIST known)
    list(APPEND bad "objeto do hh_runtime fora do manifesto: ${o}")
  endif()
endforeach()
list(REMOVE_DUPLICATES objs)
# carimbo de link: o do mapa tem de ser o do cabecalho PE (IMAGE_FILE_HEADER.TimeDateStamp)
if(EXE)
  string(REGEX MATCH "Timestamp is ([0-9a-f]+)" ts "${map}")
  set(map_ts "${CMAKE_MATCH_1}")
  if(MUTAR STREQUAL "mapa_velho")
    set(map_ts "00000001")
  endif()
  file(READ "${EXE}" pe_off_hex OFFSET 60 LIMIT 4 HEX)
  string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" pe_off_be "${pe_off_hex}")
  math(EXPR pe_off "0x${pe_off_be} + 8")
  file(READ "${EXE}" ts_hex OFFSET ${pe_off} LIMIT 4 HEX)
  string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" exe_ts "${ts_hex}")
  string(TOLOWER "${exe_ts}" exe_ts)
  if(NOT map_ts STREQUAL exe_ts)
    list(APPEND bad "o mapa e de outro link (carimbo ${map_ts}, executavel ${exe_ts})")
  endif()
endif()
if(bad)
  string(REPLACE ";" "\n  " text "${bad}")
  message(FATAL_ERROR "catraca dos papeis do produto:\n  ${text}")
endif()
list(LENGTH objs n_map)
message(STATUS "papeis do produto ok: ${n_product} objetos dos papeis do produto no manifesto, ${n_map} no mapa, sem validacao")
