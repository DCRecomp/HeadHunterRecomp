# HH15.2 (docs/planos/HH15-PLANO.md; modelo: n8_produto_papeis do BS): catraca dos papeis do runtime no produto.
# Le o manifesto (runtime_papeis.tsv: papel, fonte; gerado das mesmas listas dos alvos em runtime/CMakeLists.txt) e o
# mapa do linker do HeadHunter.exe e falha se:
#   1. um objeto dos papeis do produto (aot, nativo, simulacao, estavel, diagnostico) falta no mapa, fora da lista
#      fechada de objetos sem chamador no executavel (o linker nao os puxa da biblioteca estatica);
#   2. um objeto do papel validacao (sonda, ruido de ciclos, mutacoes) esta no mapa, ou falta o stub do produto;
#   3. o mapa tem um objeto do hh_runtime que nao esta no manifesto;
#   4. o mapa e mais antigo que o executavel (mapa de outro link).
# Uso: cmake -DMAP=<map> -DMANIFEST=<tsv> [-DEXE=<exe>] [-DMUTAR=sem_objeto|com_sonda|objeto_extra] -P check_papeis.cmake
# MUTAR (negativos): altera o texto do mapa antes da conferencia; a catraca tem de reprovar.
foreach(v MAP MANIFEST)
  if(NOT EXISTS "${${v}}")
    message(FATAL_ERROR "${v} ausente: ${${v}}")
  endif()
endforeach()
file(READ "${MAP}" map)
file(STRINGS "${MANIFEST}" rows)
set(no_caller snapshot)  # diagnostico sem chamador no produto (como no BS)
if(MUTAR STREQUAL "sem_objeto")
  string(REPLACE "hh_runtime:sys_logical.obj" "hh_runtime:removido.obj" map "${map}")
elseif(MUTAR STREQUAL "com_sonda")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f hh_runtime:hw_probe.obj\n")
elseif(MUTAR STREQUAL "objeto_extra")
  string(APPEND map "\n 0001:00000000 ?x@@ 0 f hh_runtime:desconhecido.obj\n")
endif()
set(bad "")
set(known "")
set(n_product 0)
foreach(row IN LISTS rows)
  if(row MATCHES "^papel")
    continue()
  endif()
  string(REPLACE "\t" ";" f "${row}")
  list(GET f 0 role)
  list(GET f 1 src)
  get_filename_component(obj "${src}" NAME_WE)
  list(APPEND known "${obj}")
  string(FIND "${map}" "hh_runtime:${obj}.obj" pos)
  if(role STREQUAL "validacao")
    if(NOT pos EQUAL -1)
      list(APPEND bad "objeto de validacao no produto: ${obj}")
    endif()
  else()
    math(EXPR n_product "${n_product} + 1")
    if(pos EQUAL -1 AND NOT obj IN_LIST no_caller)
      list(APPEND bad "objeto do papel ${role} ausente do mapa: ${obj}")
    endif()
  endif()
endforeach()
string(FIND "${map}" "validacao_stubs.obj" stub)
if(stub EQUAL -1)
  list(APPEND bad "o stub de validacao (validacao_stubs.obj) nao esta no produto")
endif()
string(REGEX MATCHALL "hh_runtime:[A-Za-z0-9_]+\\.obj" in_map "${map}")
list(REMOVE_DUPLICATES in_map)
foreach(m IN LISTS in_map)
  string(REGEX REPLACE "^hh_runtime:([A-Za-z0-9_]+)\\.obj$" "\\1" o "${m}")
  if(NOT o IN_LIST known)
    list(APPEND bad "objeto do hh_runtime fora do manifesto: ${o}")
  endif()
endforeach()
if(EXE AND EXISTS "${EXE}" AND NOT MUTAR)
  if("${EXE}" IS_NEWER_THAN "${MAP}")
    file(TIMESTAMP "${EXE}" te)
    file(TIMESTAMP "${MAP}" tm)
    if(NOT te STREQUAL tm)
      list(APPEND bad "o mapa e mais antigo que o executavel (mapa de outro link)")
    endif()
  endif()
endif()
if(bad)
  string(REPLACE ";" "\n  " text "${bad}")
  message(FATAL_ERROR "catraca dos papeis do produto:\n  ${text}")
endif()
list(LENGTH in_map n_map)
message(STATUS "papeis do produto ok: ${n_product} objetos dos papeis do produto no manifesto, ${n_map} no mapa, sem validacao")
